# Copy to .env and fill in. .env is git-ignored, so credentials stay out of the repo.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/iot_system

# Used for day/month boundaries on graphs and bills (180 = UTC+3).
UTC_OFFSET_MINUTES=180

# Shown next to costs in API responses.
CURRENCY=USD

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# A sensor counts as offline after this many seconds without a reading.
DEVICE_OFFLINE_AFTER_SECONDS=60
